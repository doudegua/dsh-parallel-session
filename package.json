{
  "name": "dsh-parallel-session",
  "version": "0.1.0",
  "description": "平行会话：让当前会话开启一个与用户直接交互的对等会话，并把上文交接过去",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "bash scripts/build.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "author": "doudegua",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "parallel-session",
    "peer-session",
    "session-handoff"
  ]
}
